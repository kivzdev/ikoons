{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client"],
    "paths": {
      "ikoons": ["../packages/icons/src/index.ts"],
      "ikoons/all": ["../packages/icons/src/icons/all.ts"],
      "ikoons/motion": ["../packages/icons/src/motion.ts"],
      "ikoons/icons/*": ["../packages/icons/src/icons/*"],
      "@lib/*": ["../packages/icons/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
