{
  "name": "ikoons-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "preview"
  ],
  "scripts": {
    "gen": "node scripts/generate.ts",
    "build": "npm run gen && npm run build -w ikoons",
    "dev": "npm run gen && npm run dev -w preview",
    "preview:build": "npm run gen && npm run build -w preview",
    "typecheck": "npm run gen && tsc -p packages/icons && tsc -p preview && tsc -p .",
    "test": "npm run gen && vitest run",
    "release:check": "node scripts/release-check.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "esbuild": "^0.25.11",
    "jsdom": "^27.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
